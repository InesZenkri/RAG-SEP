# Copy this to .env and fill in your keys. Don't commit .env (it's gitignored).

# Gemini - create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# HuggingFace fallback - create a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Judge model (keep separate from generator)
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-pro

# Storage (defaults are fine)
RAG_INDEX_DIR=./chroma_store
RAG_LLM_CACHE_DIR=./.llm_cache

# Cost tracking (free tiers = 0)
RAG_COST_PER_1K_INPUT=0.0
RAG_COST_PER_1K_OUTPUT=0.0
