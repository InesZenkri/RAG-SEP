# Copy to .env and fill in. All keys optional; the pipeline falls back to an
# offline "echo" LLM client when no provider credentials are present.

# Gemini (free tier) - https://aistudio.google.com/apikey
# Free tier: ~1500 requests/day for gemini-1.5-flash, multimodal-native (PDFs, images, tables).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# HuggingFace Inference API fallback
HF_API_TOKEN=
HF_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Judge model - use a different family than the generator to reduce bias
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-1.5-pro

# Storage
RAG_INDEX_DIR=./chroma_store
RAG_LLM_CACHE_DIR=./.llm_cache

# Cost tracking (euro per 1k tokens, rough estimates; 0 for free tiers)
RAG_COST_PER_1K_INPUT=0.0
RAG_COST_PER_1K_OUTPUT=0.0
