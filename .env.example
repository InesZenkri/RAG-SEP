# Copy this to .env and fill in your keys. Don't commit .env (it's gitignored).

# Gemini - create a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# HuggingFace fallback - create a free token at https://huggingface.co/settings/tokens
HF_API_TOKEN=
HF_MODEL=mistralai/Mistral-Nemo-Instruct-2407
# HF_MODEL_FALLBACK=Qwen/Qwen2.5-1.5B-Instruct

# Ollama local/cluster endpoint
OLLAMA_HOST=localhost:11434

# Judge model (keep separate from generator)
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-2.5-pro

# Storage (defaults are fine)
RAG_INDEX_DIR=./chroma_store
RAG_LLM_CACHE_DIR=./.llm_cache

# Cost tracking (free tiers = 0)
RAG_COST_PER_1K_INPUT=0.0
RAG_COST_PER_1K_OUTPUT=0.0

# GitLab team-management automation.
# Configure these as GitLab CI/CD variables for schedules.
GITLAB_URL=https://git.rz.tu-bs.de
GITLAB_TOKEN=
REMINDER_PROJECT_IDS=
REMINDER_EMAIL_FROM=
SMTP_HOST=mail.tu-braunschweig.de
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=0

# Daily assignee reminders.
RUN_ISSUE_REMINDERS=true
REMINDER_EMAIL_DOMAIN=tu-braunschweig.de
REMINDER_DRY_RUN=false

# Daily stale issue comments.
RUN_STALE_ISSUE_COMMENTS=true
STALE_ISSUE_DAYS=7
STALE_ISSUE_DRY_RUN=true

# Weekly team digest.
RUN_WEEKLY_TEAM_DIGEST=true
TEAM_DIGEST_RECIPIENTS=
TEAM_DIGEST_CC=
TEAM_DIGEST_DRY_RUN=false
DIGEST_ISSUE_LOOKBACK_DAYS=7
DIGEST_COMMIT_LOOKBACK_DAYS=1
DIGEST_DUE_WITHIN_DAYS=14
